{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023"
    ],
    "rootDir": "src",
    "outDir": "../.tmp/typescript-output",
    "newLine": "lf"
  },
  "include": [
    "src/**/*.mts",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/client.ts",
    "src/browser",
    "src/miniprogram",
    "src/types"
  ]
}
